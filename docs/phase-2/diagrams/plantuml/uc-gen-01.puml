@startuml
!pragma layout smetana
left to right direction
skinparam backgroundColor white
skinparam shadowing false
skinparam monochrome true
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam usecaseBackgroundColor white
skinparam rectangleBackgroundColor white
skinparam actorBackgroundColor white
skinparam nodesep 45
skinparam ranksep 65

actor "Quản trị viên\n(ACT-ADM)" as Admin
rectangle "SMART E-MOBILITY HUB SYSTEM" {
  usecase "Quản lý tài khoản\n(UC-GEN-01)" as Main
  usecase "Xác minh quyền quản trị" as Access
  usecase "Kiểm tra tài khoản và\nràng buộc quản trị" as Validate
  usecase "Lưu thông tin tài khoản\nvà nhật ký thay đổi" as Persist
  usecase "Tra cứu lại kết quả\nthao tác theo mã yêu cầu" as Lookup
}
Admin --> Main
Main ..> Access : <<include>>
Main ..> Validate : <<include>>
Main ..> Persist : <<include>>
Main <.. Lookup : <<extend>>\n[EF-02: kết quả lưu chưa rõ]
@enduml
